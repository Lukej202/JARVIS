{
  "manifest_version": 3,
  "name": "JARVIS Research Tabs",
  "description": "Open and read JARVIS-created research tabs in your current Chrome window, using a paired local server.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JARVIS Research Tabs",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*/*"
  ]
}
